@model IEnumerable<StaffCoreRD.Models.Staff>

@{
    ViewData["Title"] = "Personal";
}

<h2>Personal Activo</h2>

@if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
{
    <a asp-controller="Staff" asp-action="Create" class="btn btn-success mb-3">+ Nuevo</a>
}

@if (!Model.Any())
{
    <div class="alert alert-info">No hay personal activo registrado.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Departamento</th>
                <th>Salario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Cargo</td>
                    <td>@item.Departamento</td>
                    <td>@item.Salario.ToString("C")</td>
                    <td>
                        @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                        {
                            <a asp-controller="Staff" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-controller="Staff" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total de nómina</th>
                <th>@Model.Sum(s => s.Salario).ToString("C")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}